''''
-ast contains an ast.NodeVisitor class, inheriting class can override functions
that trigger upon discovering a specific type
-ast.parse() gives the whole tree, that is processed by the visitor
-for nested visits, we use NodeVisitor.generic_visit() after processing the parent node
to traverse through the children
'''


import ast

class Visitor( ast.NodeVisitor ):
    def __init__(self):
        self.visited_functions = []
        self.visited_imports = []
        self.visited_calls = []
        self.visited_classes = []
        self.visited_from_imports = []

    def visit_FunctionDef(self, node):
        print("function found", node.name)
        self.visited_functions.append(node)
        self.generic_visit(node)

    def visit_ClassDef(self, node):
        print("class found", node.name)
        self.visited_classes.append(node)
        self.generic_visit(node)

    def visit_Call(self, node):
        print("call found", self.get_qualified_name(node))
        self.visited_calls.append(node)
        self.generic_visit(node)

    def visit_Import(self, node):
        print('Import found', node.names)
        for alias in node.names:
            self.visited_imports.append(alias)

    def visit_ImportFrom(self, node):
        print('Found from imports -', node.names, " from", node.module)
    
        for alias in node.names:
            data= {
                "module" : node.module,
                "alias" : alias
            }

            self.visited_from_imports.append(data)
    

    def get_qualified_name(self,node) -> str:
        if isinstance(node, ast.Name):
            return node.id

        elif isinstance(node, (ast.ClassDef, ast.FunctionDef) ):
            return node.name

        elif isinstance(node, ast.Import):
            return ", ".join([alias.name for alias in node.names])

        elif isinstance(node, ast.ImportFrom):
            return ", ".join([ node.module + "." + alias.name for alias in node.names  ])

        elif isinstance(node, ast.Call):
            return self.get_qualified_name(node.func)

        elif isinstance(node, ast.Name):
            return node.id

        elif isinstance(node, ast.Attribute):
            return self.get_qualified_name(node.value) + "." + node.attr  

        else:
            return "undefined node: " + type(node)

    def get_visited_info(self):
        return {
            'imports' : [alias.name for alias in self.visited_imports],
            'import_froms' : [f"{data["module"]}.{data['alias'].name}" for data in self.visited_from_imports],
            'classes' : [node.name for node in self.visited_classes],
            'functions' : [node.name for node in self.visited_functions],
            'calls' : [self.get_qualified_name(call) for call in self.visited_calls],
        }

target_file = "temp2.py"

with open(target_file, "r") as f:
    tree = ast.parse(f.read())


print(ast.dump(tree, indent=4))

visitor = Visitor()
visitor.visit(tree)
info = visitor.get_visited_info()

print("\n----------------Report--------------\n")
for category, names in info.items():
    print(category.upper(),":")
    for name in names:
        print(" -", name)
    print("\n")

